[project]
name = "{{project_name}}"
version = "0.1.0"
description = "{{project_name}} – generated by Zana"
authors = [{ name = "{{author}}", email = "" }]
readme = "README.md"
license = { text = "{{license}}" }
requires-python = ">=3.11"
dependencies = []

[project.optional-dependencies]
dev = [
    "ruff",
    "mypy",
    "pytest",
]

[tool.ruff]
line-length = 88
select = ["E", "F", "W", "I", "N", "UP", "B", "C4"]
ignore = []

[tool.mypy]
strict = true

[tool.pytest.ini_options]
addopts = "-ra -q"
testpaths = ["tests"]
